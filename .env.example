# Copie para .env e ajuste. Nunca versione o .env.
DB_USER=comex
DB_PASSWORD=troque-esta-senha
API_DB_PASSWORD=troque-tambem-esta
KC_DB_PASSWORD=senha-do-banco-do-keycloak
KC_ADMIN_PASSWORD=senha-do-admin-do-keycloak
COMEX_SENHA_DEMO=Senha-Temporaria-2026     # usuários demo: troca obrigatória no 1º acesso
COMEX_ADMIN_EMAIL=admin@exemplo.com          # login do admin master (criado na importação do realm)
COMEX_SENHA_ADMIN=Outra-Senha-Temporaria   # senha temporária do admin master: troca no 1º acesso
KC_ADMIN_SECRET=segredo-longo-do-cliente-comex-admin-api   # gestão de usuários pela API (openssl rand -hex 32)

# Endereços públicos (produção com Traefik)
DOMINIO=comex.gplansis.com
COMEX_URL=https://comex.gplansis.com
# COMEX_URL_DEV=http://localhost:8000      # 2ª redirect URI do realm (só desenvolvimento; omitida = COMEX_URL)
# Com Traefik o Keycloak ganha host próprio; no servidor (Caddy, docker-compose.prod.yml) ele fica em ${COMEX_URL}/auth
KC_HOST=auth.gplansis.com
KC_URL=https://auth.gplansis.com
ADMIN_IP_ALLOW=127.0.0.1/32                  # faixas que podem abrir /admin do Keycloak (ex.: VPN)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# AUTH_MODE=desligado                        # só para laboratório: sem login, API aberta
# CORS_ORIGINS=https://outro-front.exemplo   # só se o front rodar em outra origem

# Usado pelo VS Code (API e seed fora do Docker, contra o banco em localhost:5433 e Keycloak em 8180)
DATABASE_URL=postgresql://comex_api:troque-tambem-esta@localhost:5433/gpscomex
OIDC_ISSUER=http://localhost:8180/realms/gplansis
