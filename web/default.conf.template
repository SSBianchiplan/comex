server {
  listen 80;
  server_name _;
  include /etc/nginx/conf.d/seguranca.inc;
  root /usr/share/nginx/html;
  index index.html;


  location /api/ {
    proxy_pass http://api:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
  location = /sw.js { include /etc/nginx/conf.d/seguranca.inc; add_header Cache-Control "no-cache"; try_files $uri =404; }
  location = /manifest.webmanifest { include /etc/nginx/conf.d/seguranca.inc; default_type application/manifest+json; add_header Cache-Control "no-cache"; }
  location = /index.html { include /etc/nginx/conf.d/seguranca.inc; add_header Cache-Control "no-cache"; }
  location = /app.html { include /etc/nginx/conf.d/seguranca.inc; add_header Cache-Control "no-cache"; }
  location /icons/ { include /etc/nginx/conf.d/seguranca.inc; add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / { try_files $uri $uri/ /index.html; }
}
